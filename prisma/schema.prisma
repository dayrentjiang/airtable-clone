// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// ==========================================
// AIRTABLE CLONE MODELS
// ==========================================

// Workspace = A folder containing multiple bases (like an Airtable "workspace")
model Workspace {
    id        String   @id @default(cuid())
    name      String
    starred   Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Owner of this workspace
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    // A workspace contains multiple bases
    bases Base[]

    @@index([userId]) // Fast lookup: "Get all workspaces for this user"
}

// Base = A container for multiple tables (like an Airtable "base")
model Base {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Which workspace this base belongs to
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    workspaceId String

    // A base contains multiple tables
    tables Table[]

    @@index([workspaceId]) // Fast lookup: "Get all bases in this workspace"
}

// Table = A spreadsheet within a base
model Table {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Which base this table belongs to
    base   Base   @relation(fields: [baseId], references: [id], onDelete: Cascade)
    baseId String

    // A table has columns and rows
    columns Column[]
    rows    Row[]

    @@index([baseId]) // Fast lookup: "Get all tables in this base"
}

// Column = Defines structure (name, type, order)
model Column {
    id        String     @id @default(cuid())
    name      String
    type      ColumnType @default(TEXT)
    order     Int        @default(0) // Display order (left to right)
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    // Which table this column belongs to
    table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
    tableId String

    @@index([tableId])              // Fast lookup: "Get all columns for this table"
    @@index([tableId, order])       // Fast lookup: "Get columns in display order"
}

// Row = A record in the table, with data stored as JSONB
model Row {
    id        String   @id @default(cuid())
    data      Json     @default("{}") // JSONB: { "columnId1": "value", "columnId2": 123 }
    order     Int      @default(0)    // Display order (top to bottom)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Which table this row belongs to
    table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
    tableId String

    @@index([tableId])              // Fast lookup: "Get all rows for this table"
    @@index([tableId, order])       // Fast pagination: "Get rows 100-200"
    // Note: GIN index on 'data' will be added via raw SQL migration for fast JSONB search
}

// Column types supported
enum ColumnType {
    TEXT
    NUMBER
}

//To Implement --> View Table

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String      @id @default(cuid())
    name          String?
    email         String?     @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    workspaces    Workspace[] // User's workspaces
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
